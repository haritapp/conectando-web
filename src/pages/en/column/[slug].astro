---
// src/pages/en/column/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import ColumnContactPrompt from '../../../components/ColumnContactPrompt.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { formatDateEN } from '../../../lib/date';
import { categoryLabel } from '../../../lib/categories';

export async function getStaticPaths() {
  const entries = await getCollection('column', (entry) => entry.data.lang === 'en');

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const displayDate = formatDateEN(entry.data.date);
const badgeLabel = categoryLabel(entry.data.category, 'en');

// Articles with a Japanese counterpart carry its slug in `altSlug`.
const jaAltPath = entry.data.altSlug ? `/column/${entry.data.altSlug}/` : undefined;
const ogImage = entry.data.heroImage ? new URL(entry.data.heroImage, Astro.site).toString() : undefined;
---

<BaseLayout title={`${entry.data.pageTitle ?? entry.data.title} | Conectando`} rawTitle description={entry.data.description} altJaPath={jaAltPath} ogImage={ogImage}>

  {entry.data.heroImage && (
    <div class="detail-hero">
      <img src={entry.data.heroImage} alt={entry.data.title} class="hero-img" />
      {entry.data.heroCredit && <p class="hero-credit">{entry.data.heroCredit}</p>}
    </div>
  )}

  <div class="page-wrap">
    <h1 class="detail-h1">{entry.data.title}</h1>
    <div class="detail-meta">
      <div class="detail-meta-info">
        <time class="detail-date">{displayDate}</time>
        <span class="detail-tag">{badgeLabel}</span>
      </div>
      <ShareButtons lang="en" size="small" />
    </div>

    <div class="detail-body-wrap">
      {entry.data.lead && <p class="lead">{entry.data.lead}</p>}
      <Content />
    </div>

    <ShareButtons lang="en" size="normal" />

    <ColumnContactPrompt />

    <div class="back-row">
      <a href="/en/column" class="back-link">← Back to all columns</a>
    </div>
  </div>

  <ContactCTA trackSource="column_banner" />

</BaseLayout>

<style>
.detail-hero {
  max-width: 52rem;
  margin: 2rem auto 0;
  padding: 0 2rem;
}
.hero-img {
  width: 100%;
  height: auto;
  display: block;
}
.hero-credit {
  font-size: .75rem;
  color: var(--color-text-muted);
  margin: .5rem 0 0;
  text-align: right;
}

.page-wrap {
  max-width: 42rem;
  margin: 0 auto;
  padding: 0 2rem 5rem;
}
.detail-h1 {
  font-size: clamp(1.375rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--color-brand);
  margin: 2rem 0 .75rem;
  line-height: 1.5;
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.detail-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: .625rem .75rem;
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #e5e7eb;
}
.detail-meta-info {
  display: flex;
  align-items: center;
  gap: .625rem;
}
.detail-date { font-size: .875rem; color: var(--color-text-muted); }
.detail-tag {
  font-size: .6875rem;
  padding: .1875rem .5rem;
  background: var(--color-accent);
  color: var(--color-brand);
  border: 1px solid #c7c7f5;
  border-radius: 9999px;
  font-weight: 600;
}

.detail-body-wrap { margin-bottom: 2.5rem; }
.detail-body-wrap :global(h2) {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-brand);
  margin: 2.25rem 0 .75rem;
  line-height: 1.5;
}
.detail-body-wrap :global(h2:first-child) { margin-top: 0; }
.detail-body-wrap :global(h3) {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-brand);
  margin: 2.25rem 0 .75rem;
  line-height: 1.5;
}
.detail-body-wrap :global(p.lead) {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.75;
  margin-bottom: 1rem;
}
.detail-body-wrap :global(p) {
  color: var(--color-text);
  line-height: 1.75;
  font-size: 1.0625rem;
  margin-bottom: 1rem;
}
.detail-body-wrap :global(p:last-child) { margin-bottom: 0; }
/* A paragraph that is a single bold run (**text**) stands in for the old "label" block. */
.detail-body-wrap :global(p:has(> strong:only-child)) {
  font-weight: 700;
  color: var(--color-text);
  font-size: 1.0625rem;
  margin: 1rem 0 .5rem;
}
.detail-body-wrap :global(ul),
.detail-body-wrap :global(ol) {
  margin: 0 0 1rem;
  padding-left: 1.25rem;
  color: var(--color-text);
  font-size: 1.0625rem;
  line-height: 1.75;
}
.detail-body-wrap :global(ol) { list-style: decimal; }
.detail-body-wrap :global(li) { margin-bottom: .375rem; }
.detail-body-wrap :global(img) {
  display: block;
  width: 100%;
  height: auto;
  margin: 1.5rem 0;
}

.detail-body-wrap :global(table) {
  display: block;
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-collapse: collapse;
  margin: 1.5rem 0;
  font-size: .9375rem;
}
.detail-body-wrap :global(th),
.detail-body-wrap :global(td) {
  padding: .625rem .75rem;
  border: 1px solid #e5e7eb;
  text-align: left;
  white-space: nowrap;
  color: var(--color-text);
}
.detail-body-wrap :global(th) {
  background: var(--color-accent);
  color: var(--color-brand);
  font-weight: 700;
}

.detail-body-wrap :global(a.venue-card) {
  display: flex;
  align-items: stretch;
  gap: 1rem;
  margin: 1.5rem 0;
  padding: .75rem;
  border: 1px solid #e5e7eb;
  border-radius: var(--radius-md);
  text-decoration: none;
  color: inherit;
  transition: border-color .15s, background-color .15s;
}
.detail-body-wrap :global(a.venue-card:hover) {
  border-color: var(--color-brand-light);
  background: var(--color-accent);
}
.detail-body-wrap :global(.venue-card-img) {
  width: 40%;
  max-width: 12rem;
  aspect-ratio: 16/9;
  object-fit: cover;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  margin: 0;
}
.detail-body-wrap :global(.venue-card-body) {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: .25rem;
  min-width: 0;
}
.detail-body-wrap :global(.venue-card-title) {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.4;
}
.detail-body-wrap :global(.venue-card-desc) {
  font-size: .875rem;
  color: var(--color-text-muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.detail-body-wrap :global(.venue-card-domain) {
  font-size: .75rem;
  color: var(--color-text-muted);
}

@media (max-width: 640px) {
  .detail-body-wrap :global(p),
  .detail-body-wrap :global(ul),
  .detail-body-wrap :global(ol) {
    font-size: 1rem;
  }
  .detail-body-wrap :global(a.venue-card) {
    flex-direction: column;
  }
  .detail-body-wrap :global(.venue-card-img) {
    width: 100%;
    max-width: none;
  }
}
</style>
