---
// src/pages/en/column/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import { formatDateEN } from '../../../lib/date';

export async function getStaticPaths() {
  const entries = await getCollection('column', (entry) => entry.data.lang === 'en');

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const displayDate = formatDateEN(entry.data.date);

// Articles with a Japanese counterpart carry its slug in `altSlug`.
const jaAltPath = entry.data.altSlug ? `/column/${entry.data.altSlug}/` : undefined;
---

<BaseLayout title={`${entry.data.pageTitle ?? entry.data.title} | Conectando`} rawTitle description={entry.data.description} altJaPath={jaAltPath}>

  {entry.data.heroImage && (
    <div class="detail-hero">
      <img src={entry.data.heroImage} alt={entry.data.title} class="hero-img" />
    </div>
  )}

  <div class="page-wrap">
    <h1 class="detail-h1">{entry.data.title}</h1>
    <div class="detail-meta">
      <time class="detail-date">{displayDate}</time>
      <span class="detail-tag">Event</span>
    </div>

    <div class="detail-body-wrap">
      <Content />
    </div>

    <div class="back-row">
      <a href="/en/column" class="back-link">← Back to all columns</a>
    </div>
  </div>

  <ContactCTA />

</BaseLayout>

<style>
.detail-hero {
  max-width: 52rem;
  margin: 2rem auto 0;
  padding: 0 2rem;
}
.hero-img {
  width: 100%;
  height: auto;
  display: block;
}

.page-wrap {
  max-width: 52rem;
  margin: 0 auto;
  padding: 0 2rem 5rem;
}
.detail-h1 {
  font-size: clamp(1.375rem, 3vw, 2rem);
  font-weight: 800;
  color: var(--color-brand);
  margin: 2rem 0 .75rem;
  line-height: 1.5;
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.detail-meta {
  display: flex;
  align-items: center;
  gap: .625rem;
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #e5e7eb;
}
.detail-date { font-size: .875rem; color: var(--color-text-muted); }
.detail-tag {
  font-size: .6875rem;
  padding: .1875rem .5rem;
  background: var(--color-accent);
  color: var(--color-brand);
  border: 1px solid #c7c7f5;
  border-radius: 9999px;
  font-weight: 600;
}

.detail-body-wrap { margin-bottom: 2.5rem; }
.detail-body-wrap :global(h2) {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-brand);
  margin: 2.5rem 0 1rem;
  line-height: 1.5;
}
.detail-body-wrap :global(h2:first-child) { margin-top: 0; }
.detail-body-wrap :global(p.lead) {
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.6;
  margin-bottom: 1rem;
}
.detail-body-wrap :global(p) {
  color: var(--color-text-muted);
  line-height: 1.9;
  font-size: .9375rem;
  margin-bottom: 1rem;
}
.detail-body-wrap :global(p:last-child) { margin-bottom: 0; }
</style>
