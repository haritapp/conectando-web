---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout title="Page not found | Conectando" rawTitle description="The page you're looking for could not be found.">

  <PageHero label="ERROR" title="404" />

  <div class="page-wrap">
    <p class="not-found-lead">Page not found</p>
    <p class="not-found-desc">The page you're looking for may have been moved or removed.</p>
    <a href="/en/" class="back-btn">Back to home →</a>
  </div>

</BaseLayout>

<style>
.page-wrap {
  max-width: 40rem;
  margin: 0 auto;
  padding: 4rem 2rem 6rem;
  text-align: center;
}
.not-found-lead {
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--color-brand);
  margin-bottom: .75rem;
}
.not-found-desc {
  font-size: .9375rem;
  color: var(--color-text-muted);
  line-height: 1.8;
  margin-bottom: 2.5rem;
}
.back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: #fff;
  padding: .875rem 1.75rem;
  border-radius: 9999px;
  font-weight: 700;
  font-size: .9375rem;
  text-decoration: none;
  transition: opacity .2s;
}
.back-btn:hover { opacity: .85; text-decoration: none; }
</style>
