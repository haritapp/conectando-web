---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AnchorNav from '../../components/AnchorNav.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const navItems = [
  { label: 'Event Operations',       href: '#service-1' },
  { label: 'Media & Promotion',      href: '#service-4' },
  { label: 'Delegations & Tours',    href: '#service-2' },
  { label: 'Japan Market Entry',     href: '#service-3' },
];

const cases = [
  { title: 'Gate to India & Africa 2025', date: 'July 7, 2025', href: '/en/case/detail/gatetoindiaafrica2025', img: '/images/service/case-1-gate-india-africa.webp' },
  { title: 'New York Silicon Alley Meetup #12', date: 'May 8, 2025', href: '/en/case/detail/newyorksiliconalley12', img: '/images/service/case-2-ny-silicon-alley.webp' },
  { title: 'India & Africa Founders and Investors Meetup in Kyoto — The Momentum of the Global South', date: 'July 4, 2025', href: '/en/case/detail/indoafrica2025', img: '/images/service/case-3-india-africa-kyoto.webp' },
];
---

<BaseLayout title="Services | Conectando" rawTitle description="Conectando's services: event operations in English, attendee logistics and promotion via BizinTokyo, delegations and company visits, and Japan market entry support.">

  <PageHero label="SERVICE" title="SERVICE" />

  <div class="page-wrap">

    <p class="page-lead">
      An introduction to the services Conectando provides.<br>
      For each service, we cover key features, how it works, and case studies.
    </p>

    <AnchorNav items={navItems} />

    <!-- ① Event operations in English -->
    <section id="service-1" class="svc-section">
      <h2 class="svc-h2">Event operations in English</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        We run business events in Tokyo where English is required — from planning and venue booking to the day itself. We speak English with your headquarters team and speakers, and Japanese with venues and local vendors, so nobody on your side has to sit in the middle translating. Most of our work is for tech companies, startups and investors, and corporate innovation teams.
      </p>

      <h3 class="sub-heading">Key Features</h3>
      <div class="features">
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">You talk to us directly, in English</h4>
            <p class="feature-desc">Coordination with overseas organizers, speakers and attendees is handled by us in English — emails, calls, and on the venue floor. You never have to wonder whether the Japanese vendor understood the brief.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">We make Japanese venues work for English-speaking clients</h4>
            <p class="feature-desc">We translate what you need — run of show, catering, AV, networking format — into what Tokyo venues and vendors can actually deliver. And we explain Japanese constraints back to you in English, before they become surprises.</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-event-3-international-group.webp" alt="We make the event work for Japanese attendees too" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">We make the event work for Japanese attendees too</h4>
            <p class="feature-desc">English-only events can leave Japanese participants on the sidelines. We build in bilingual moderation and Japanese-language moments so both your international guests and your Japanese audience get value.</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">How It Works</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">Planning</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">Venue booking</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">Speaker and attendee communication (in English)</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">On-site operations</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">Wrap-up</h4>
          </div>
        </li>
      </ol>
      <p class="flow-note">On-site operations only, venue search only — single components are welcome.</p>
    </section>

    <!-- ④ Attendee logistics and promotion (via BizinTokyo) -->
    <section id="service-4" class="svc-section">
      <h2 class="svc-h2">Attendee logistics and promotion (via BizinTokyo)</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        We run BizinTokyo, a bilingual guide to Tokyo's business event venues, hotels and restaurants. For your event, that means English-speaking attendees can find out where it is, how to get there and where to stay — without you building all of that from scratch.
      </p>

      <h3 class="sub-heading">Key Features</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-media-1.jpg" alt="Event listing and promotion (English and Japanese)" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">Event listing and promotion (English and Japanese)</h4>
            <p class="feature-desc">An experienced writer produces an article about your event in both languages, published on BizinTokyo and shared through our channels, so English-speaking attendees can find it.</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-media-2.jpg" alt="Venue, hotel and access guidance for attendees" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">Venue, hotel and access guidance for attendees</h4>
            <p class="feature-desc">Directions to the venue, nearby hotels and restaurants, drawn from BizinTokyo's existing guides. Fewer "where should I stay?" emails for you.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">Venue data that feeds your event</h4>
            <p class="feature-desc">We use the same venue, hotel and restaurant data when we plan and run your event in Tokyo. Media and operations under one roof.</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">How It Works</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">Briefing</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">Content proposal</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">Production and publishing</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">Results summary</h4>
          </div>
        </li>
      </ol>
    </section>

    <!-- ② Delegations: company visits and investor meetings -->
    <section id="service-2" class="svc-section">
      <h2 class="svc-h2">Delegations: company visits and investor meetings</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        For business visitors coming to Tokyo — headquarters teams, partners, investors, founder delegations — we plan the schedule of company visits, meetings and event attendance, and accompany you in English on the day.
      </p>

      <h3 class="sub-heading">Key Features</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-tour-1-seminar-venue.webp" alt="Visits and curated meetings" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">Visits and curated meetings</h4>
            <p class="feature-desc">Tell us who you want to meet. We handle the outreach and scheduling with Japanese companies and investors, in Japanese, and set up meetings that fit your goals.</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-tour-2.jpg" alt="English-speaking accompaniment on the day" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">English-speaking accompaniment on the day</h4>
            <p class="feature-desc">We travel with your delegation, run the schedule, and handle on-the-spot coordination with the Japanese side — as a host who understands the purpose of the visit, not as an interpreter.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">Practical Tokyo know-how</h4>
            <p class="feature-desc">Venues, hotels, restaurants and getting around — we know the city and point you to what works, drawing on BizinTokyo.</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">How It Works</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">Briefing</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">Proposed schedule</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">Outreach and preparation</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">Day-of accompaniment</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">Follow-up and introductions</h4>
          </div>
        </li>
      </ol>
    </section>

    <!-- ③ Japan market entry -->
    <section id="service-3" class="svc-section">
      <h2 class="svc-h2">Japan market entry</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        When an event or visit turns into "we should do this properly in Japan", we are the first conversation. We give you an honest read on the Japanese market and on who you should be talking to, and we introduce English-speaking specialists for incorporation, visas, hiring and office space.
      </p>

      <h3 class="sub-heading">Key Features</h3>
      <div class="features">
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">An honest first read</h4>
            <p class="feature-desc">Who your customers and partners in Japan might be, and which people in which industries are worth meeting — based on the network we have built through our events.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">Introductions to specialists</h4>
            <p class="feature-desc">Incorporation, visas, hiring, office space: we introduce specialists and firms we actually work with, and who speak English.</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-expansion-3.jpg" alt="Continuity from your event or visit" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">Continuity from your event or visit</h4>
            <p class="feature-desc">If we ran your event or hosted your delegation, we carry that context and those relationships into your market entry. No starting from zero.</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">How It Works</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">Briefing</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">Market read and plan</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">Introductions</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">Execution with specialists</h4>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">Ongoing support</h4>
          </div>
        </li>
      </ol>
    </section>

    <!-- Case studies (shared, not part of anchor nav) -->
    <section class="svc-section cases-section">
      <h3 class="sub-heading">Case Studies</h3>
      <div class="cases-grid">
        {cases.map(c => (
          <a href={c.href} class="case-card">
            <img src={c.img} alt={c.title} class="case-img" loading="lazy" />
            <div class="case-body">
              <time class="case-date">{c.date}</time>
              <p class="case-title">{c.title}</p>
              <span class="case-badge">Event Management Support</span>
            </div>
          </a>
        ))}
      </div>
      <div class="center-cta">
        <a href="/en/case" class="pill-btn">View All <span class="btn-dot">●</span></a>
      </div>
    </section>

  </div><!-- /page-wrap -->

  <ContactCTA />

</BaseLayout>

<style>
.page-wrap {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 2rem 4rem;
}
.page-lead {
  color: var(--color-text-muted);
  line-height: 1.8;
  margin: 2rem 0 2.5rem;
  font-size: .9375rem;
}

/* ── Service section ── */
.svc-section {
  padding-top: 4rem;
  margin-bottom: 2rem;
  scroll-margin-top: 5rem;
}
.svc-h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 800;
  color: var(--color-brand);
  margin-bottom: .75rem;
  display: flex;
  align-items: center;
  gap: .75rem;
}
.flow-note {
  font-size: .875rem;
  color: var(--color-text-muted);
  margin-top: 1.25rem;
}
.svc-rule {
  border: none;
  border-top: 2px solid var(--color-brand);
  margin-bottom: 2rem;
}
.svc-lead {
  color: var(--color-text-muted);
  line-height: 1.85;
  max-width: 52rem;
  font-size: .9375rem;
  margin-bottom: 3rem;
}

/* ── Sub heading ── */
.sub-heading {
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: 1.125rem;
  font-weight: 800;
  color: var(--color-brand);
  line-height: 1;
  margin: 2.5rem 0 1.5rem;
}
.sub-heading::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 1.125rem;
  background: var(--color-brand);
  border-radius: 2px;
}

/* ── Features (image left / text right rows) ── */
.features {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  margin-bottom: 1rem;
}
.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 3rem;
}
.feature-img {
  width: 25rem;
  max-width: 40%;
  aspect-ratio: 3/2;
  object-fit: cover;
  border-radius: .5rem;
  flex-shrink: 0;
}
.feature-text {
  flex: 1;
  padding-top: .25rem;
}
.feature-num {
  display: block;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-text-muted);
  line-height: 1;
  margin-bottom: .75rem;
}
.feature-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: .75rem;
}
.feature-desc {
  font-size: .9375rem;
  color: var(--color-text-muted);
  line-height: 1.8;
}

/* ── Flow (2-col grid of cards) ── */
.flow-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}
.flow-step {
  background: var(--color-accent);
  border-radius: .5rem;
  padding: 2rem;
}
.flow-num {
  display: block;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-brand);
  opacity: .35;
  line-height: 1;
  margin-bottom: .75rem;
}
.flow-title {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: .75rem;
}
.flow-desc {
  font-size: .875rem;
  color: var(--color-text-muted);
  line-height: 1.8;
}

/* ── Cases ── */
.cases-section { padding-top: 2rem; }
.cases-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1rem;
}
.case-card {
  display: block;
  text-decoration: none;
  color: inherit;
  border: 1px solid #e5e7eb;
  border-radius: .5rem;
  overflow: hidden;
}
.case-img {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  display: block;
}
.case-body {
  padding: .875rem;
}
.case-date  { display: block; font-size: .75rem; color: var(--color-text-muted); margin-bottom: .25rem; }
.case-title { font-size: .875rem; font-weight: 600; color: var(--color-text); line-height: 1.5; margin-bottom: .5rem; }
.case-badge {
  font-size: .6875rem;
  padding: .125rem .5rem;
  background: var(--color-brand);
  color: #fff;
  border-radius: 9999px;
}

/* ── CTA ── */
.center-cta { display: flex; justify-content: center; margin-top: 2rem; }
.pill-btn {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  background: var(--color-brand);
  color: #fff;
  padding: .75rem 1.75rem;
  border-radius: 9999px;
  font-weight: 600;
  font-size: .9375rem;
  text-decoration: none;
  transition: opacity .2s;
}
.pill-btn:hover { opacity: .85; }
.btn-dot { font-size: .55em; }

@media (max-width: 640px) {
  .feature-row { flex-direction: column; }
  .feature-img { width: 100%; max-width: 100%; }
  .flow-list { grid-template-columns: 1fr; }
  .cases-grid { grid-template-columns: 1fr; }
}
</style>
