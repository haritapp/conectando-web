---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const services = [
  {
    num: '01',
    tag: 'core',
    title: 'Event operations in English',
    desc: 'Planning, venue, speakers and on-site operations, end to end.',
    href: '/en/service#service-1',
  },
  {
    num: '02',
    tag: '',
    title: 'Attendee logistics and promotion',
    desc: 'Reach attendees through our media, BizinTokyo.',
    href: '/en/service#service-4',
  },
  {
    num: '03',
    tag: '',
    title: 'Delegations and tours',
    desc: 'Company visits and site tours for visiting guests.',
    href: '/en/service#service-2',
  },
  {
    num: '04',
    tag: '',
    title: 'Japan market entry',
    desc: 'Use an event as your first step into Japan.',
    href: '/en/service#service-3',
  },
];

const cases = [
  {
    title: 'Gate to India & Africa 2025',
    summary: 'Official IVS side event · approx. 200 attendees',
    href: '/en/case/detail/gatetoindiaafrica2025',
    img: '/images/top/hero-gatetoindiaafrica.webp',
  },
  {
    title: 'New York Silicon Alley Meetup #12',
    summary: 'SusHi Tech Tokyo side event · 131 attendees',
    href: '/en/case/detail/newyorksiliconalley12',
    img: '/images/top/case-newyorksiliconalley-2.webp',
  },
  {
    title: 'India & Africa Founders and Investors Meetup in Kyoto',
    summary: 'IVS side event in Kyoto · 100 attendees',
    href: '/en/case/detail/indoafrica2025',
    img: '/images/top/case-indiaafrica-kyoto-2.webp',
  },
];

const why = [
  {
    num: '01',
    headline: 'You talk to us directly, in English',
    sub: 'No interpreter between you and the people running your event.',
  },
  {
    num: '02',
    headline: 'We know your industry',
    sub: 'The terms, the speakers, the audience — no explanation needed.',
  },
  {
    num: '03',
    headline: 'On-site only, or end to end',
    sub: 'Venue search only, or the whole event — your call.',
  },
];

const columns = [
  { date: '2024.10.07', title: '外資系企業の日本担当者が日本でイベントを開催する際に考慮すべき4つのポイント', href: '/column/4point' },
  { date: '2024.09.19', title: '英語の主催者が日本でイベントを成功させるたった1つのポイント', href: '/column/eigoevent' },
];

const news = [
  { date: '2026.03.13', title: '東京のビジネスイベント情報メディア「BizinTokyo」を開設しました', href: 'https://bizintokyo.com', external: true },
  { date: '2025.11.07', title: 'note「Rice Capital福山×グロービス高宮」を公開しました', href: 'https://note.com/firstfollowers/n/ndfa752c7b6bb', external: true },
  { date: '2025.10.29', title: 'note「LayerXが語る、AI時代の経営プレイブック」を公開しました', href: 'https://note.com/firstfollowers/n/n461becdd12b9', external: true },
];
---

<BaseLayout title="Conectando | Run your Tokyo event in English, from planning to on-site" rawTitle description="Conectando is an event operations partner for overseas teams bringing an event to Tokyo, and Japanese companies hosting international guests.">

<!-- ① Hero: photo → label → heading → sentence → button -->
<section class="hero-photo-band">
  <img src="/images/top/hero-gatetoindiaafrica.webp" alt="Group photo from Gate to India & Africa 2025" loading="eager" />
</section>
<section class="hero1">
  <div class="hero-body">
    <p class="hero-eyebrow">TOKYO · ENGLISH BUSINESS EVENTS</p>
    <h1 class="hero-h1">
      Your Tokyo event,<br>
      run in English.
    </h1>
    <p class="hero-lead">An event operations partner for overseas teams bringing an event to Tokyo, and Japanese companies hosting international guests.</p>
    <div class="hero-btns">
      <a href="/en/contact" class="btn">Talk to us about your event →</a>
    </div>
  </div>
</section>

<!-- ② SERVICE -->
<section class="svc-sec">
  <div class="sec-body">
    <div class="sec-label">SERVICE</div>
    <ul class="svc-grid" role="list">
      {services.map(s => (
        <li class:list={['svc-item', { 'svc-item-core': s.tag }]}>
          <a href={s.href} class="svc-link">
            <div class="svc-eyebrow">{s.num}{s.tag && <> · {s.tag}</>}</div>
            <h3 class="svc-title">{s.title}<span class="svc-tag-mobile">{s.tag}</span></h3>
            <p class="svc-desc">{s.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ③ CASE -->
<section class="cases-sec">
  <div class="sec-body">
    <div class="sec-head-row">
      <div class="sec-label">CASE</div>
      <a href="/en/case" class="text-cta">See all case studies <span class="btn-dot">●</span></a>
    </div>
    <div class="case-grid">
      {cases.map(c => (
        <a href={c.href} class="case-card">
          <img src={c.img} alt={c.title} class="case-img" loading="lazy" />
          <h3 class="case-title">{c.title}</h3>
          <p class="case-summary">{c.summary}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ④ WHY -->
<section class="why-sec">
  <div class="sec-body">
    <div class="why-box">
      <div class="sec-label">WHY</div>
      <ul class="why-grid" role="list">
        {why.map(w => (
          <li class="why-item">
            <div class="why-num">{w.num}</div>
            <p class="why-headline">{w.headline}</p>
            <p class="why-sub">{w.sub}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ⑤ COLUMN / NEWS (Japanese-language content, no English version yet) -->
<section class="cn-sec">
  <div class="sec-body">
    <div class="cn-grid">
      <div>
        <div class="sec-head-row">
          <div class="sec-label">COLUMN</div>
          <a href="/column" class="text-cta">See all columns <span class="btn-dot">●</span></a>
        </div>
        <ul class="cn-list" role="list">
          {columns.map(c => (
            <li class="cn-item">
              <a href={c.href} class="cn-link">
                <span class="cn-date">{c.date}</span>
                <span class="cn-text">{c.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="sec-head-row">
          <div class="sec-label">NEWS</div>
          <a href="/news" class="text-cta">See all news <span class="btn-dot">●</span></a>
        </div>
        <ul class="cn-list" role="list">
          {news.map(n => (
            <li class="cn-item">
              <a href={n.href} class="cn-link" target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>
                <span class="cn-date">{n.date}</span>
                <span class="cn-text">{n.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<ContactCTA text="Tell us about your event — no dates, venue or headcount needed yet." buttonText="Contact us →" />

</BaseLayout>

<style>
/* ─── Hero ─── */
.hero-photo-band { width: 100%; height: 400px; overflow: hidden; }
.hero-photo-band img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 78%;
  display: block;
}

.hero1 { padding: 2.5rem 0 1.5rem; }
.hero-body { max-width: 80rem; margin: 0 auto; padding: 0 2rem; }
.hero-eyebrow {
  font-size: .8125rem;
  letter-spacing: .16em;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: .875rem;
}
.hero-h1 {
  font-size: clamp(1.875rem, 1.1rem + 3vw, 3rem);
  font-weight: 700;
  line-height: 1.3;
  color: var(--color-heading);
  letter-spacing: -0.01em;
  margin-bottom: 1.25rem;
}
.hero-lead {
  font-size: clamp(1.0625rem, .95rem + .5vw, 1.375rem);
  color: var(--color-text);
  line-height: 1.7;
  margin-bottom: 1.75rem;
  max-width: 42rem;
}
.hero-btns { display: flex; }
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: #fff;
  padding: 1.0625rem 2rem;
  border-radius: 9999px;
  font-weight: 700;
  font-size: 1rem;
  text-decoration: none;
  transition: opacity .2s;
}
.btn:hover { opacity: .85; text-decoration: none; }

/* ─── Section body / labels ─── */
.sec-body { max-width: 80rem; margin: 0 auto; padding: 0 2rem; }
.sec-label {
  font-size: .8125rem;
  letter-spacing: .16em;
  font-weight: 700;
  color: var(--color-brand);
}
.sec-head-row { display: flex; align-items: baseline; justify-content: space-between; }

.svc-sec { padding-top: 6rem; }
.cases-sec { padding-top: 7rem; }
.why-sec { padding-top: 7rem; }
.cn-sec { padding-top: 7rem; }

/* ─── Right CTA (view all) ─── */
.text-cta {
  display: inline-flex;
  align-items: center;
  gap: .375rem;
  color: var(--color-brand);
  font-weight: 700;
  font-size: .9375rem;
  text-decoration: none;
}
.text-cta:hover { opacity: .75; text-decoration: none; }
.btn-dot { font-size: .55em; }

/* ─── Services ─── */
.svc-grid {
  list-style: none;
  padding: 0;
  margin: 1.75rem 0 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  border-top: 1px solid var(--color-border);
}
.svc-item { padding-top: 1.5rem; margin-top: -1px; border-top: 1px solid transparent; }
.svc-item-core { border-top: 3px solid var(--color-brand); }
.svc-link { display: block; text-decoration: none; color: inherit; }
.svc-eyebrow {
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--color-text-muted);
}
.svc-item-core .svc-eyebrow { color: var(--color-brand); }
.svc-title {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--color-heading);
  line-height: 1.4;
  margin-top: .75rem;
}
.svc-tag-mobile {
  display: none;
  font-size: .6875rem;
  font-weight: 700;
  color: var(--color-brand);
  margin-left: .5rem;
  vertical-align: middle;
}
.svc-desc {
  font-size: .875rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-top: .625rem;
}

/* ─── Cases ─── */
.case-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 1.75rem;
}
.case-card { display: flex; flex-direction: column; gap: .875rem; text-decoration: none; color: inherit; }
.case-card:hover { text-decoration: none; }
.case-img { width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: .5rem; display: block; }
.case-title { font-size: 1.25rem; font-weight: 700; color: var(--color-heading); line-height: 1.4; }
.case-summary { font-size: .875rem; color: var(--color-text-muted); }

/* ─── Why ─── */
.why-box {
  background: var(--color-accent);
  border-radius: .5rem;
  padding: 3.5rem;
}
.why-grid {
  list-style: none;
  padding: 0;
  margin: 1rem 0 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}
.why-item { display: flex; flex-direction: column; }
.why-num {
  font-size: .8125rem;
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--color-brand);
  margin-bottom: .75rem;
}
.why-headline {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-heading);
  line-height: 1.45;
  word-break: keep-all;
  overflow-wrap: anywhere;
  margin-bottom: .625rem;
}
.why-sub {
  font-size: .875rem;
  color: var(--color-text-muted);
  line-height: 1.7;
}

/* ─── Column / News ─── */
.cn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
}
.cn-list { list-style: none; padding: 0; margin: 1.25rem 0 0; border-top: 1px solid var(--color-border); }
.cn-item { border-bottom: 1px solid var(--color-border); }
.cn-link { display: flex; gap: 1.25rem; padding: 1.25rem 0; text-decoration: none; transition: opacity .15s; }
.cn-link:hover { opacity: .75; text-decoration: none; }
.cn-date { flex: none; width: 6rem; font-size: .8125rem; color: var(--color-text-muted); }
.cn-text { font-size: .9375rem; color: var(--color-heading); line-height: 1.6; }

@media (max-width: 768px) {
  .hero-photo-band { height: 340px; }
  .hero-photo-band img { object-position: 45% 75%; }
  .hero-body { padding: 0 1.25rem; }
  .sec-body { padding: 0 1.25rem; }
  .hero-btns .btn { width: 100%; }

  .svc-sec { padding-top: 3.5rem; }
  .cases-sec { padding-top: 3.5rem; }
  .why-sec { padding-top: 3.5rem; }
  .cn-sec { padding-top: 3.5rem; }

  .svc-grid { grid-template-columns: 1fr; gap: 0; }
  .svc-item { border-top: none; border-bottom: 1px solid var(--color-border); padding: 1.125rem 0; }
  .svc-item-core { border-top: none; }
  .svc-item-core .svc-eyebrow { display: none; }
  .svc-eyebrow { display: none; }
  .svc-tag-mobile { display: inline; }
  .svc-title { margin-top: 0; font-size: 1.25rem; }

  .case-grid { grid-template-columns: 1fr; gap: 2rem; }

  .why-box { padding: 1.75rem 1.5rem; }
  .why-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  .why-headline { font-size: 1.125rem; }

  .cn-grid { grid-template-columns: 1fr; gap: 3rem; }
}
</style>
