---
// src/pages/en/venues/[slug].astro — 会場ごとの運営者向けページ（英語）。中身は共通部品。
import VenueDetail from '../../../components/venues/VenueDetail.astro';
import { getVenues } from '../../../lib/venues';

export function getStaticPaths() {
  return getVenues().map((v) => ({ params: { slug: v.slug } }));
}
const { slug } = Astro.params;
---

<VenueDetail slug={slug!} lang="en" />
