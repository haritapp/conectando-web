---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AnchorNav from '../components/AnchorNav.astro';
import ContactCTA from '../components/ContactCTA.astro';

const navItems = [
  { label: '英語イベント運営',           href: '#service-1' },
  { label: 'メディア運用',               href: '#service-4' },
  { label: '視察・アテンド・ツアー手配', href: '#service-2' },
  { label: '日本進出支援',               href: '#service-3' },
];

const cases = [
  { title: 'Gate to India & Africa 2025',    date: '2025年7月7日開催',  href: '/case/detail/gatetoindiaafrica',   img: '/images/service/case-1-gate-india-africa.webp' },
  { title: 'New York Silicon Alley Meetup #12', date: '2025年5月8日開催', href: '/case/detail/newyorksiliconalley', img: '/images/service/case-2-ny-silicon-alley.webp' },
  { title: '【インド・アフリカ】起業家・投資家交流会 〜京都で感じるグローバルサウスの勢い〜', date: '2025年7月4日開催', href: '/case/detail/gatetoindiaafrica', img: '/images/service/case-3-india-africa-kyoto.webp' },
];
---

<BaseLayout title="サービス一覧 | 英語イベント運営・視察アテンドツアー手配・日本進出支援" description="Conectandoのサービス一覧。英語イベント運営・メディア運用・視察アテンドツアー手配・日本進出支援をご紹介します。">

  <PageHero label="SERVICE" title="SERVICE" />

  <div class="page-wrap">

    <p class="page-lead">
      Conectandoの提供するサービスのご紹介です。<br>
      各サービスの特徴、導入の流れ、導入事例をご紹介します。
    </p>

    <AnchorNav items={navItems} />

    <!-- ① 英語イベント運営（主軸） -->
    <section id="service-1" class="svc-section">
      <h2 class="svc-h2">英語イベント運営<span class="main-badge">主軸</span></h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        英語対応が必要なイベントの運営を、企画から実行までワンストップで支援します。私たちのサービスは、イベントの企画立案、会場手配、当日の運営サポートに至るまで、すべてのプロセスを一貫してサポートします。さらに、英語での対応が可能なため、海外からの主催者も言語の壁を感じることなく、安心してイベントを開催できます。テック・イノベーション分野を得意としています。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-event-1.jpg" alt="ワンストップサポート" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">ワンストップサポート</h4>
            <p class="feature-desc">企画立案から会場手配、当日の運営まで、イベント全体を一貫してサポートし、主催者の負担を軽減します。特にスタートアップや国際会議の開催経験が豊富で、専門性の高いサポートを提供します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-event-2.jpg" alt="英語対応" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">英語対応</h4>
            <p class="feature-desc">海外の主催者に向けた英語対応が可能で、言語の壁を感じることなくイベントを円滑に進行できます。さらに、日本人スタッフが常にサポートするため、国際イベントでも安心して進行できます。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-event-3-international-group.webp" alt="多国籍のビジネスパーソンが交流するイベントの様子" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">国際的視点</h4>
            <p class="feature-desc">日本市場に精通しつつ、国際的な視点を持ったイベント運営を実現し、多様なニーズに応えます。また、国際イベントでよくある日本人が参加しづらい環境を避け、英語が苦手な日本人でも参加しやすいイベントを開催します。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">サービスの流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">企画</h4>
            <p class="flow-desc">目的、ターゲット層、開催日、予算など要望をヒアリングし、コンセプトとプログラム内容を設計します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">会場手配</h4>
            <p class="flow-desc">会場の選定・予約、レイアウトや設備の確認、契約手続きまでを代行します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">登壇者・来場者対応（英語）</h4>
            <p class="flow-desc">登壇者や海外からの来場者とのやり取りを英語で直接行い、担当者を介さずに調整します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">当日運営</h4>
            <p class="flow-desc">受付・進行管理・トラブル対応など、当日の運営全般をサポートします。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">振り返り</h4>
            <p class="flow-desc">開催後のレポートをまとめ、次回に向けた改善点を共有します。</p>
          </div>
        </li>
      </ol>
      <p class="flow-note">「当日運営のみ」「会場手配のみ」など、一部だけのご依頼も承ります。</p>
    </section>

    <!-- ④ メディア運用 -->
    <section id="service-4" class="svc-section">
      <h2 class="svc-h2">メディア運用</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        自社運営のバイリンガルメディア「BizinTokyo」を通じて、東京で開催されるビジネスイベント情報を日本語・英語で発信しています。イベント主催者様のプロモーション支援から、参加者向けの会場・宿泊・交通情報の提供まで、メディアの力でイベントの集客と参加者体験の向上をサポートします。国内外の読者にリーチできるコンテンツ制作で、イベントの認知拡大と成功を後押しします。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-media-1.jpg" alt="バイリンガルメディア" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">バイリンガルメディア</h4>
            <p class="feature-desc">日本語と英語の両方でコンテンツを制作・配信。国内の参加者はもちろん、海外からのビジネスパーソンにも効果的にリーチし、イベントの集客力を最大化します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-media-2.jpg" alt="イベントプロモーション支援" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">イベントプロモーション支援</h4>
            <p class="feature-desc">イベント掲載記事の制作、SNSでの情報拡散、ニュースレター配信など、多角的なプロモーションでイベントの認知度を向上させます。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-media-3.jpg" alt="参加者向け情報コンテンツ" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">参加者向け情報コンテンツ</h4>
            <p class="feature-desc">会場ガイド、周辺ホテル情報、インターネット環境ガイドなど、参加者が必要とする実用的な情報コンテンツを提供し、イベント体験の質を高めます。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">ヒアリング</h4>
            <p class="flow-desc">メディア掲載についてのご要望をヒアリングします。イベントの概要、ターゲット読者層、プロモーションの目的、掲載希望時期などを詳しくお伺いし、最適なコンテンツプランをご提案するための基礎情報を整理します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">プロモーション企画・提案</h4>
            <p class="flow-desc">ヒアリング内容を基に、イベントの特徴を活かしたプロモーション企画をご提案します。記事コンテンツの方向性、SNS拡散プラン、ニュースレター配信スケジュールなど、多角的なメディア戦略を立案します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">コンテンツ制作・掲載</h4>
            <p class="flow-desc">承認いただいた企画に基づき、プロのライターがバイリンガルコンテンツを制作します。イベント紹介記事、参加者向けガイド、SNS投稿素材などを作成し、BizinTokyoメディアに掲載・配信します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">レポート・フォローアップ</h4>
            <p class="flow-desc">掲載コンテンツの効果測定レポートをお届けします。PV数、読者の反応、SNSでのシェア状況などを分析し、次回のプロモーション改善に活かすためのフィードバックを提供します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">イベント開催</h4>
            <p class="flow-desc">当日運営：イベントの進行管理、会場内外のサポート、トラブル対応など、スムーズな運営を行います。各担当者が役割を果たし、予定通りにイベントが進行するよう監督します。</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ② 視察・アテンド・ツアー手配 -->
    <section id="service-2" class="svc-section">
      <h2 class="svc-h2">視察・アテンド・ツアー手配</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        視察や業界イベントへの参加を通じ、クライアントが日本市場を深く理解し、現地のビジネスパートナーとのマッチングを実現するための日本ツアーを開催します。クライアントのニーズに合わせた訪問先やイベントの選定、スケジュール調整を行い、効果的なビジネスマッチングの機会を提供します。日本での新たなビジネスチャンスを発見し、確かなネットワークを構築するための最適なツアーです。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-tour-1-seminar-venue.webp" alt="視察・アテンドセミナーに参加するビジネスパーソンの様子" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">オーダーメイドのツアープラン</h4>
            <p class="feature-desc">クライアントのニーズに合わせ、視察先やイベント参加、ビジネスマッチングの機会を厳選したオーダーメイドのツアーを企画します。日本市場の理解を深めると同時に、最適なビジネスパートナーとの出会いを実現します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-tour-2.jpg" alt="ビジネスマッチングのサポート" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">ビジネスマッチングのサポート</h4>
            <p class="feature-desc">業界イベントや企業訪問を通じて、日本国内でのビジネスマッチングを強力にサポートします。クライアントが求めるパートナーやネットワークを築くための機会を提供し、ビジネスの成功を後押しします。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-tour-3.jpg" alt="柔軟な対応とフォローアップ" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">柔軟な対応とフォローアップ</h4>
            <p class="feature-desc">ツアーの予約手配から現地でのサポートまで、クライアントの要望に応じた柔軟な対応を行います。さらに、ツアー後の振り返りやフォローアップを通じて、次のビジネスステップをサポートします。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">ヒアリング</h4>
            <p class="flow-desc">ニーズの把握：クライアントのツアー目的、対象市場、希望する訪問先、参加したいイベント、ビジネスマッチングのニーズなどを詳細にヒアリングします。この段階で、クライアントの要望や目標を具体化し、ツアーの大枠を形成します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">ツアー企画提案</h4>
            <p class="flow-desc">オーダーメイドプランの作成：ヒアリング内容に基づき、視察先やイベント参加、マッチングの機会を組み込んだオーダーメイドのツアー企画を提案します。提案書には、スケジュールや訪問先の詳細、期待される成果などが含まれます。*企画のみの場合有料</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">見積もり提出</h4>
            <p class="flow-desc">詳細見積もり：提案したツアー企画に基づき、訪問先や移動手段、宿泊施設、イベント参加費用など、必要なすべての項目の詳細な見積もりを作成し、クライアントに提出します。クライアントの予算や要望に応じて、見積もり内容の調整も可能です</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">ツアー予約・準備</h4>
            <p class="flow-desc">予約手配：訪問先や宿泊施設、移動手段、イベント参加などの予約を代行し、ツアーの準備を進めます。予約のみの手配も対応可能です。ツアーの詳細調整：クライアントと密に連携し、ツアーのスケジュールや細部を最終調整します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">ツアー実施</h4>
            <p class="flow-desc">現地サポート：ツアー当日は、スムーズな進行をサポートするため、現地でのコーディネートやトラブル対応などを行い、クライアントが日本での体験を最大限に活用できるよう支援します。</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ③ 日本進出支援 -->
    <section id="service-3" class="svc-section">
      <h2 class="svc-h2">日本進出支援</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        私たちは、海外企業が日本市場に進出する際の課題をトータルでサポートします。まず、市場調査を通じてターゲット市場や競合状況を分析し、日本での成功戦略を構築します。次に、現地での採用活動を支援し、企業に最適な人材を確保します。また、オフィス探しでは、ニーズや予算に合わせた最適なロケーションを提案し、スムーズな設立準備をサポートします。これにより、日本市場への進出を安心して進めることができます。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-expansion-1.jpg" alt="市場調査とトライアル営業" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">市場調査とトライアル営業</h4>
            <p class="feature-desc">ターゲット市場の調査に加え、実際のトライアル営業を通じて、日本市場でのビジネス可能性を検証し、成功に向けたデータと戦略を提供します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-expansion-2.jpg" alt="採用とオフィス選定サポート" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">採用とオフィス選定サポート</h4>
            <p class="feature-desc">現地での優秀な人材の採用を支援するとともに、クライアントのニーズや予算に合わせた最適なオフィスロケーションを提案し、スムーズな設立準備をサポートします。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-expansion-3.jpg" alt="営業サポート" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">営業サポート</h4>
            <p class="feature-desc">日本市場での営業活動を支援し、現地のビジネス文化や商習慣に基づいた効果的な営業戦略の立案と実施をサポートします。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">初回ヒアリング</h4>
            <p class="flow-desc">ニーズ把握：クライアントの業界や日本市場への進出目的、目標、ターゲット市場を詳細にヒアリングします。特に市場調査、トライアル営業、採用やオフィス選定のニーズを確認します。初回提案：ヒアリングを基に、初期的な進出計画の概要を提示し、進め方の大枠を確認します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">見積もり提出</h4>
            <p class="flow-desc">具体的なサポート内容の確定：市場調査とトライアル営業の結果を基に、採用支援、オフィス探し、営業サポートを含む全体的なサポート内容を決定します。見積もり提示：提案内容に応じて、具体的な見積もりを提示します。クライアントの予算に合わせて調整も可能です。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">市場調査とトライアル営業</h4>
            <p class="flow-desc">市場調査実施：日本市場のターゲット層、競合分析、消費者ニーズを調査し、クライアントにレポートとして提出します。トライアル営業：実際のトライアル営業活動を通じて、商談や現地の反応を確認し、ビジネスの可能性を評価します。この結果を基に、戦略を最適化します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
