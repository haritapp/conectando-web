---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AnchorNav from '../components/AnchorNav.astro';
import ContactCTA from '../components/ContactCTA.astro';

const navItems = [
  { label: '英語イベント運営',           href: '#service-1' },
  { label: 'メディア運用',               href: '#service-4' },
  { label: '視察・アテンド・ツアー手配', href: '#service-2' },
  { label: '日本進出支援',               href: '#service-3' },
];

const cases = [
  { title: 'Gate to India & Africa 2025',    date: '2025年7月7日開催',  href: '/case/detail/gatetoindiaafrica2025',   img: '/images/top/case-gatetoindiaafrica2025.png' },
  { title: 'New York Silicon Alley Meetup #12', date: '2025年5月8日開催', href: '/case/detail/newyorksiliconalley12', img: '/images/top/case-newyorksiliconalley.png' },
  { title: '【インド・アフリカ】起業家・投資家交流会 〜京都で感じるグローバルサウスの勢い〜', date: '2025年7月4日開催', href: '/case/detail/indoafrica2025', img: '/images/top/case-indiaafrica-kyoto.png' },
];
---

<BaseLayout title="サービス" description="Conectandoのサービス一覧。英語イベント運営・メディア運用・視察アテンドツアー手配・日本進出支援をご紹介します。">

  <PageHero label="SERVICE" title="SERVICE" />

  <div class="page-wrap">

    <p class="page-lead">
      Conectandoの提供するサービスのご紹介です。<br>
      各サービスの特徴、導入の流れ、導入事例をご紹介します。
    </p>

    <AnchorNav items={navItems} />

    <!-- ① 英語イベント運営 -->
    <section id="service-1" class="svc-section">
      <h2 class="svc-h2">英語イベント運営</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        英語が必要になるビジネスイベントを、企画から会場手配、当日運営まで引き受けます。本国のチームや海外の登壇者とは英語で、日本の会場や協力会社とは日本語で、私たちが直接やり取りします。担当者が両者の間で通訳役になる必要はありません。テクノロジー企業、スタートアップ・投資家、大企業の新規事業部門が集まるイベントを多く手がけてきました。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-event-1.webp" alt="英語で直接話せる" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">英語で直接話せる</h4>
            <p class="feature-desc">海外の主催者・登壇者・来場者との調整は、担当者を介さず私たちが英語で行います。メールも、当日の会場でのやり取りも同じです。「日本の運営会社に英語で伝わっているか」を確かめる手間がなくなります。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-event-2.webp" alt="日本の会場・協力会社を英語の要望に合わせる" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">日本の会場・協力会社を英語の要望に合わせる</h4>
            <p class="feature-desc">海外側の要望（進行の形式、ケータリング、機材、ネットワーキングの時間の取り方）を、日本の会場や協力会社が実行できる形に置き換えて手配します。逆に、日本側の事情や制約は英語で本国に説明します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-event-3-international-group.webp" alt="日本人も参加しやすい国際イベントにする" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">日本人も参加しやすい国際イベントにする</h4>
            <p class="feature-desc">英語のイベントは、英語が得意でない日本人参加者が居心地悪くなりがちです。バイリンガルの進行や、日本語で話せる場を組み込み、海外ゲストと日本側の参加者の両方が満足する設計にします。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">サービスの流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">企画</h4>
            <p class="flow-desc">目的、ターゲット層、開催日、予算など要望をヒアリングし、コンセプトとプログラム内容を設計します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">会場手配</h4>
            <p class="flow-desc">会場の選定・予約、レイアウトや設備の確認、契約手続きまでを代行します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">登壇者・来場者対応（英語）</h4>
            <p class="flow-desc">登壇者や海外からの来場者とのやり取りを英語で直接行い、担当者を介さずに調整します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">当日運営</h4>
            <p class="flow-desc">受付・進行管理・トラブル対応など、当日の運営全般をサポートします。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">振り返り</h4>
            <p class="flow-desc">開催後のレポートをまとめ、次回に向けた改善点を共有します。</p>
          </div>
        </li>
      </ol>
      <p class="flow-note">「当日運営のみ」「会場手配のみ」など、一部だけのご依頼も承ります。</p>
    </section>

    <!-- ④ メディア運用 -->
    <section id="service-4" class="svc-section">
      <h2 class="svc-h2">メディア運用</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        自社で運営するバイリンガルの会場ガイド「BizinTokyo」を使って、東京で開くビジネスイベントの集客と、参加者の案内をお手伝いします。会場・周辺ホテル・レストラン・アクセスの情報を日本語と英語で持っているので、海外からの参加者に「どこで、どう来て、どこに泊まるか」を、主催者が一から作らなくても伝えられます。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-media-1.jpg" alt="イベントの掲載と告知（日本語・英語）" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">イベントの掲載と告知（日本語・英語）</h4>
            <p class="feature-desc">経験のあるライターがイベントの紹介記事を日本語と英語で制作し、BizinTokyo に掲載します。記事とSNSなどを組み合わせて告知し、海外の参加者が検索で見つけられる形にします。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-media-2.jpg" alt="参加者向けの会場・宿泊・アクセス案内" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">参加者向けの会場・宿泊・アクセス案内</h4>
            <p class="feature-desc">会場までの行き方、周辺のホテル、近くのレストランを、BizinTokyo の既存の記事を使って案内します。参加者からの「どこに泊まればいい？」という問い合わせが減ります。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-media-3.webp" alt="会場データをイベント設計に活かす" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">会場データをイベント設計に活かす</h4>
            <p class="feature-desc">東京の MICE 会場・ホテル・レストランの自社データを、英語イベント運営の会場選びや宿泊手配にそのまま使います。メディアと運営が同じ会社にあることの利点です。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">ヒアリング</h4>
            <p class="flow-desc">イベントの概要、対象の参加者、掲載したい時期を伺います。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">掲載内容の提案</h4>
            <p class="flow-desc">記事の方向性と、参加者向け案内の範囲を提案します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">制作・掲載</h4>
            <p class="flow-desc">日本語・英語の記事を制作し、BizinTokyo に掲載・告知します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">結果報告</h4>
            <p class="flow-desc">掲載後の状況を簡単に報告します。</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ② 視察・アテンド・ツアー手配 -->
    <section id="service-2" class="svc-section">
      <h2 class="svc-h2">視察・アテンド・ツアー手配</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        海外から東京に来るビジネス訪問客のために、企業訪問・視察・商談・イベント参加の日程を組み、当日は英語で同行します。海外の本社チーム、取引先、投資家、起業家の一団など、「日本に来る人たちの数日間」をまとめて引き受けます。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-tour-1-seminar-venue.webp" alt="訪問先の調整と商談相手の紹介" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">訪問先の調整と商談相手の紹介</h4>
            <p class="feature-desc">訪問したい企業・施設・イベントを伺い、先方との日程調整と依頼を日本語で行います。目的に合う日本企業や投資家との商談の場もつくります。日本側との細かいやり取りを、訪問客が自分でする必要はありません。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-tour-2.jpg" alt="英語でのアテンド" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">英語でのアテンド</h4>
            <p class="feature-desc">当日は英語で同行し、移動・会議・見学・商談の進行と、その場での日本側との調整を行います。通訳ではなく、訪問の目的を理解した同行者として動きます。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-tour-3.webp" alt="東京の実用情報" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">東京の実用情報</h4>
            <p class="feature-desc">会場・ホテル・レストラン・アクセスの情報を BizinTokyo で日本語と英語で持っています。滞在中に困りがちな「どこで食事をするか」「どう移動するか」を先回りして案内します。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">ヒアリング</h4>
            <p class="flow-desc">目的、人数、日程、訪問したい先や会いたい相手を伺います。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">日程案の提案</h4>
            <p class="flow-desc">訪問先と商談候補を含めた日程案を提案します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">訪問先の調整・準備</h4>
            <p class="flow-desc">先方への依頼、日程確定、当日の段取りを整えます。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">当日のアテンド</h4>
            <p class="flow-desc">英語で同行し、進行と現場の調整を行います。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">振り返り</h4>
            <p class="flow-desc">訪問後の連絡や、次につながる紹介を行います。</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ③ 日本進出支援 -->
    <section id="service-3" class="svc-section">
      <h2 class="svc-h2">日本進出支援</h2>
      <hr class="svc-rule" />

      <p class="svc-lead">
        イベントや視察をきっかけに「日本で本格的に事業を始めたい」となったとき、最初の相談相手になります。日本市場の見立てや、誰に会えばよいかは私たちが一緒に考え、法人設立・採用・オフィスといった専門的な手続きは、信頼できる専門家や会社を紹介します。
      </p>

      <h3 class="sub-heading">サービスの特徴</h3>
      <div class="features">
        <div class="feature-row">
          <img src="/images/service/feature-expansion-1.webp" alt="最初の相談と市場の見立て" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">01</span>
            <h4 class="feature-title">最初の相談と市場の見立て</h4>
            <p class="feature-desc">日本でどんな顧客・パートナーが見込めるか、どの業界の誰に会うべきかを、これまでのイベントで築いた人のつながりをもとに一緒に整理します。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-expansion-2.webp" alt="専門家の紹介" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">02</span>
            <h4 class="feature-title">専門家の紹介</h4>
            <p class="feature-desc">法人設立、ビザ、採用、オフィス探しなど、専門知識が必要な手続きは、私たちが実際に付き合いのある専門家や会社を紹介します。丸投げされて困る相手ではなく、英語で話せる相手を選びます。</p>
          </div>
        </div>
        <div class="feature-row">
          <img src="/images/service/feature-expansion-3.jpg" alt="イベントと視察からの続き" class="feature-img" loading="lazy" />
          <div class="feature-text">
            <span class="feature-num">03</span>
            <h4 class="feature-title">イベントと視察からの続き</h4>
            <p class="feature-desc">Conectando のイベント運営や視察アテンドを使った企業には、そこで得た人脈と知見をそのまま引き継いで支援します。ゼロから説明し直す必要がありません。</p>
          </div>
        </div>
      </div>

      <h3 class="sub-heading">導入の流れ</h3>
      <ol class="flow-list">
        <li class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h4 class="flow-title">ヒアリング</h4>
            <p class="flow-desc">事業内容、日本での目標、時期を伺います。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h4 class="flow-title">市場の見立てと進め方の提案</h4>
            <p class="flow-desc">見込める顧客・パートナーと、会うべき相手を整理します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h4 class="flow-title">専門家の紹介</h4>
            <p class="flow-desc">必要な手続きごとに、英語で話せる専門家や会社を紹介します。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">04</span>
          <div>
            <h4 class="flow-title">進出の実行</h4>
            <p class="flow-desc">専門家と並走しながら、法人設立・採用・オフィスなどを進めます。</p>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">05</span>
          <div>
            <h4 class="flow-title">進出後のフォロー</h4>
            <p class="flow-desc">進出後も、イベントや人脈づくりで継続して支援します。</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- 導入事例（共通・ナビ対象外） -->
    <section class="svc-section cases-section">
      <h3 class="sub-heading">導入事例</h3>
      <div class="cases-grid">
        {cases.map(c => (
          <a href={c.href} class="case-card">
            <img src={c.img} alt={c.title} class="case-img" loading="lazy" />
            <div class="case-body">
              <time class="case-date">{c.date}</time>
              <p class="case-title">{c.title}</p>
              <span class="case-badge">英語イベント運営</span>
            </div>
          </a>
        ))}
      </div>
      <div class="center-cta">
        <a href="/case" class="pill-btn">すべて見る <span class="btn-dot">●</span></a>
      </div>
    </section>

  </div><!-- /page-wrap -->

  <ContactCTA />

</BaseLayout>

<style>
.page-wrap {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 2rem 4rem;
}
.page-lead {
  color: var(--color-text-muted);
  line-height: 1.8;
  margin: 2rem 0 2.5rem;
  font-size: .9375rem;
}

/* ── Service section ── */
.svc-section {
  padding-top: 4rem;
  margin-bottom: 2rem;
  scroll-margin-top: 5rem;
}
.svc-h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 800;
  color: var(--color-brand);
  margin-bottom: .75rem;
  display: flex;
  align-items: center;
  gap: .75rem;
}
.flow-note {
  font-size: .875rem;
  color: var(--color-text-muted);
  margin-top: 1.25rem;
}
.svc-rule {
  border: none;
  border-top: 2px solid var(--color-brand);
  margin-bottom: 2rem;
}
.svc-lead {
  color: var(--color-text-muted);
  line-height: 1.85;
  max-width: 52rem;
  font-size: .9375rem;
  margin-bottom: 3rem;
}

/* ── Sub heading ── */
.sub-heading {
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: 1.125rem;
  font-weight: 800;
  color: var(--color-brand);
  line-height: 1;
  margin: 2.5rem 0 1.5rem;
}
.sub-heading::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 1.125rem;
  background: var(--color-brand);
  border-radius: 2px;
}

/* ── Features (image left / text right rows) ── */
.features {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  margin-bottom: 1rem;
}
.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 3rem;
}
.feature-img {
  width: 25rem;
  max-width: 40%;
  aspect-ratio: 3/2;
  object-fit: cover;
  border-radius: .5rem;
  flex-shrink: 0;
}
.feature-text {
  flex: 1;
  padding-top: .25rem;
}
.feature-num {
  display: block;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-text-muted);
  line-height: 1;
  margin-bottom: .75rem;
}
.feature-title {
  font-size: 1.25rem;
  font-weight: 700;
