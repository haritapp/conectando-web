---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { formatDateJP } from '../../lib/date';

const entries = await getCollection('column', (entry) => entry.data.lang === 'ja');
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const columns = entries.map((entry) => ({
  date: formatDateJP(entry.data.date),
  title: entry.data.title,
  href: `/column/${entry.data.slug}`,
  img: entry.data.heroImage,
}));
---

<BaseLayout title="Column | Conectando" rawTitle description="Conectandoのコラム。イベント運営・日本進出支援に関する情報を発信しています。">

  <PageHero label="COLUMN" title="コラム" />

  <div class="page-wrap">
    <p class="page-lead">すべてのコラム</p>

    <ul class="column-list">
      {columns.map(c => (
        <li class="column-item">
          <a href={c.href} class="column-link">
            {c.img && (
              <img src={c.img} alt={c.title} class="column-thumb" loading="lazy" />
            )}
            <span class="column-body">
              <time class="column-date">{c.date}</time>
              <span class="column-text">{c.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <ContactCTA />

</BaseLayout>

<style>
.page-wrap { max-width: 56rem; margin: 0 auto; padding: 0 2rem 5rem; }
.page-lead {
  color: var(--color-text-muted);
  font-size: .9375rem;
  font-weight: 600;
  margin: 2rem 0 2rem;
}
.column-list { list-style: none; padding: 0; margin: 0; }
.column-item { border-bottom: 1px solid #d1d5db; }
.column-item:first-child { border-top: 1px solid #d1d5db; }
.column-link {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1rem 0;
  text-decoration: none;
  color: inherit;
  transition: opacity .15s;
}
.column-link:hover { opacity: .75; }
.column-thumb {
  width: 7.5rem;
  aspect-ratio: 16/9;
  object-fit: cover;
  border-radius: .375rem;
  flex-shrink: 0;
}
.column-body {
  display: flex;
  flex-direction: column;
  gap: .375rem;
  min-width: 0;
}
.column-date { font-size: .8125rem; color: var(--color-text-muted); white-space: nowrap; }
.column-text { font-size: .9375rem; color: var(--color-text); line-height: 1.5; }

@media (max-width: 640px) {
  .column-link { gap: .875rem; }
  .column-thumb { width: 5rem; }
  .column-text { font-size: .875rem; }
}
</style>
