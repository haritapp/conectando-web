---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { newsItems, formatNewsDateJP } from '../../data/news';

const badgeColors: Record<string, string> = {
  'コーポレート': '#1A1AB4',
  'note更新': '#41c9b4',
  'コラム': '#f59e0b',
  'ケーススタディ': '#6366f1',
};
---

<BaseLayout title="News | Conectando" rawTitle description="Conectandoからのお知らせ。コーポレート・プレスリリース・イベント情報などを発信しています。">

  <PageHero label="NEWS" title="NEWS" />

  <div class="page-wrap">
    <p class="page-lead">Conectandoからのお知らせです。<br>コーポレート、プレスリリース、イベント情報などを発信しています。</p>

    <ul class="news-list">
      {newsItems.map(n => (
        <li class="news-item">
          {n.href ? (
            <a
              href={n.href}
              class="news-link"
              target={n.external ? '_blank' : undefined}
              rel={n.external ? 'noopener' : undefined}
            >
              <time class="news-date">{formatNewsDateJP(n.date)}</time>
              <span
                class="news-badge"
                style={`background:${badgeColors[n.badge] ?? '#1A1AB4'}`}
              >{n.badge}</span>
              <span class="news-text">{n.title}</span>
            </a>
          ) : (
            <span class="news-link news-link-disabled">
              <time class="news-date">{formatNewsDateJP(n.date)}</time>
              <span
                class="news-badge"
                style={`background:${badgeColors[n.badge] ?? '#1A1AB4'}`}
              >{n.badge}</span>
              <span class="news-text">{n.title}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>

  <ContactCTA />

</BaseLayout>

<style>
.page-wrap { max-width: 56rem; margin: 0 auto; padding: 0 2rem 5rem; }
.page-lead {
  color: var(--color-text-muted);
  line-height: 1.8;
  font-size: .9375rem;
  margin: 2rem 0 2.5rem;
}
.news-list { list-style: none; padding: 0; margin: 0; }
.news-item { border-bottom: 1px solid #d1d5db; }
.news-item:first-child { border-top: 1px solid #d1d5db; }
.news-link {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: .75rem;
  padding: 1rem 0;
  text-decoration: none;
  color: inherit;
  transition: opacity .15s;
}
.news-link:hover { opacity: .75; }
.news-link-disabled { cursor: default; }
.news-link-disabled:hover { opacity: 1; }
.news-date { font-size: .8125rem; color: var(--color-text-muted); white-space: nowrap; }
.news-badge {
  font-size: .6875rem;
  padding: .1875rem .625rem;
  color: #fff;
  border-radius: 9999px;
  white-space: nowrap;
}
.news-text { font-size: .9375rem; color: var(--color-text); line-height: 1.5; }
</style>
