---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const cases = [
  {
    slug:      'gatetoindiaafrica2025',
    title:     'Gate to India & Africa 2025',
    date:      '2025年7月7日開催',
    service:   '英語イベント運営',
    format:    'カンファレンス',
    summary:   'IVS公式サイドイベント。日本とインド・アフリカのスタートアップをつなぐカンファレンス。',
    organizer: 'SGgrow Pte Ltd／Uncovered Fund',
    img:       '/images/top/case-gatetoindiaafrica2025.webp',
    href:      '/case/detail/gatetoindiaafrica2025',
  },
  {
    slug:      'newyorksiliconalley12',
    title:     'New York Silicon Alley Meetup #12',
    date:      '2025年5月8日開催',
    service:   '英語イベント運営',
    format:    'ミートアップ',
    summary:   'SusHi Tech Tokyo 2025サイドイベント。NYのスタートアップエコシステムを紹介。',
    organizer: 'Square Up New York',
    img:       '/images/top/case-newyorksiliconalley.webp',
    href:      '/case/detail/newyorksiliconalley12',
  },
  {
    slug:      'indoafrica2025',
    title:     '【インド・アフリカ】起業家・投資家交流会 〜京都で感じるグローバルサウスの勢い〜',
    date:      '2025年7月4日開催',
    service:   '英語イベント運営',
    format:    '交流会',
    summary:   'IVS開催期間中の京都サイドイベント。インド・アフリカと日本の起業家・投資家が交流。',
    organizer: 'SGgrow Pte Ltd／Uncovered Fund',
    img:       '/images/top/case-indiaafrica-kyoto.webp',
    href:      '/case/detail/indoafrica2025',
  },
  {
    slug:      'solanasupertokyo',
    title:     'Solana Super Tokyo - Main Conference',
    date:      '2024年8月18日開催',
    service:   'イベント運営支援',
    format:    'カンファレンス',
    summary:   '650名を超えるSolanaコミュニティが集結した大規模カンファレンス。',
    organizer: 'Superteam Japan',
    img:       '/images/top/case-solanasupertokyo.webp',
    href:      '/case/detail/solanasupertokyo',
  },
  {
    slug:      'newyorksiliconalley',
    title:     'New York Silicon Alley Meetup #11',
    date:      '2024年5月9日開催',
    service:   '英語イベント運営',
    format:    'ミートアップ',
    summary:   '約6年ぶりのNY拠点投資家・起業家イベント。ニューヨークの最新エコシステムを紹介。',
    organizer: 'SQRP NY',
    img:       '/images/top/hero-main-nysiliconalley.webp',
    href:      '/case/detail/newyorksiliconalley',
  },
  {
    slug:      'startupdiversityday',
    title:     'Startup Diversity Day',
    date:      '2024年5月14日開催',
    service:   '英語イベント運営',
    format:    'カンファレンス',
    summary:   'SusHiTech Tokyoサイドイベント。多様性とスタートアップの革新性を議論。',
    organizer: 'Yazawa Ventures',
    img:       '/images/top/hero-startupdiversityday.webp',
    href:      '/case/detail/startupdiversityday',
  },
  {
    slug:      'gatetoindiaafrica',
    title:     'Gate to India & Africa 2024',
    date:      '2024年7月9日開催',
    service:   '英語イベント運営',
    format:    'カンファレンス',
    summary:   'IVS公式サイドイベント。日本とインド・アフリカのスタートアップをつなぐカンファレンス。',
    organizer: 'SGgrow Pte Ltd／Uncovered Fund',
    img:       '/images/top/hero-gatetoindiaafrica.webp',
    href:      '/case/detail/gatetoindiaafrica',
  },
];
---

<BaseLayout title="導入事例" description="海外ゲストを迎える英語イベントの運営事例。カンファレンス、ミートアップ、交流会など">

  <PageHero label="CASE" title="CASE" />

  <div class="page-wrap">
    <p class="page-lead">すべての導入事例</p>

    <div class="case-grid">
      {cases.map(c => (
        <a href={c.href} class="case-card">
          <img src={c.img} alt={c.title} class="case-img" loading="lazy" />
          <div class="case-body">
            <time class="case-date">{c.date}</time>
            <p class="case-title">{c.title}</p>
            <p class="case-summary">{c.summary}</p>
            <p class="case-organizer">主催：{c.organizer}</p>
            <div class="case-badges">
              <span class="case-badge">{c.service}</span>
              <span class="case-badge case-badge-format">{c.format}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <ContactCTA />

</BaseLayout>

<style>
.page-wrap {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 2rem 5rem;
}
.page-lead {
  color: var(--color-text-muted);
  font-size: .9375rem;
  margin: 2rem 0 2rem;
  font-weight: 600;
}
.case-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}
.case-card {
  display: block;
  text-decoration: none;
  color: inherit;
  border: 1px solid #e5e7eb;
  border-radius: .5rem;
  overflow: hidden;
  transition: box-shadow .2s;
}
.case-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
.case-img {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  display: block;
}
.case-body { padding: 1rem 1.125rem 1.25rem; }
.case-date { display: block; font-size: .75rem; color: var(--color-text-muted); margin-bottom: .375rem; }
.case-title { font-size: .9375rem; font-weight: 600; color: var(--color-text); line-height: 1.5; margin-bottom: .375rem; }
.case-summary { font-size: .8125rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: .625rem; }
.case-organizer { font-size: .75rem; color: var(--color-text-muted); margin-bottom: .625rem; }
.case-badges { display: flex; flex-wrap: wrap; gap: .375rem; }
.case-badge {
  font-size: .6875rem;
  padding: .1875rem .625rem;
  background: var(--color-brand);
  color: #fff;
  border-radius: 9999px;
}
.case-badge-format {
  background: var(--color-accent);
  color: var(--color-brand);
}
</style>
