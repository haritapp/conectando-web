---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  rawTitle?: boolean;
}

const { title, description = 'Bilingual event planning & management in Tokyo.', ogImage = 'https://www.conec-tando.com/images/top/hero-gatetoindiaafrica.webp', rawTitle = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = rawTitle ? title : `${title}｜Conectando`;

const pathname = Astro.url.pathname;
const isColumnPath = pathname === '/column' || pathname.startsWith('/column/');
const jaAltPath = pathname.startsWith('/en') ? pathname.replace(/^\/en/, '') || '/' : pathname;
const enAltPath = pathname.startsWith('/en') ? pathname : `/en${pathname}`;
const hasAltLang = !isColumnPath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hasAltLang && (
      <>
        <link rel="alternate" hreflang="ja" href={new URL(jaAltPath, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(enAltPath, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(jaAltPath, Astro.site)} />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8X3TF7N11H"></script>
    <script define:vars={{ gaId: 'G-8X3TF7N11H' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

