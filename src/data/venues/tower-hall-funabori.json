 "ops": {
  "loadingHours": {
   "text": "ホール専用サービスヤードは7:00〜23:00。",
   "source": "https://www.towerhall.jp/tower/wp-content/uploads/2022/06/ks05.pdf"
  },
  "vehicleRules": {
   "text": "搬入口は、大ホール利用者専用（入口高3.8m・3台）、展示ホール利用者専用（入口高3.5m・2台）、小ホール利用者専用（入口高3.7m・2台）。搬入経路の高架は高さ3.6mと4.2m。",
   "source": "https://www.towerhall.jp/tower/wp-content/uploads/2022/04/map_keiro.png"
  },
  "parking": {
   "text": "地下1階74台・地下2階87台（計161台）。高さ制限は2.6mで、車椅子など広い駐車スペースが必要な人向けの区画もある。利用時間は8:30〜22:00。料金は最初の1時間200円、以後1時間ごとに100円。催しによって満車になる場合があり、公共交通機関の利用をすすめている。",
   "source": "https://www.towerhall.jp/access/"
  },
  "waitingRooms": {
   "text": "大ホールの楽屋は4階に5室（第一 和6畳・シャワー付、第二 洋18㎡・シャワー付、第三 和11畳、第四 洋31㎡、第五 洋51㎡）。小ホールの楽屋は5階に4室（第一 和12畳、第二 洋37㎡、第三 洋25㎡、第四 洋23㎡）。2階イベントホール用の控室は松・桜・藤（席数38・定員12名）。料金は料金表に載っている。",
   "source": "https://www.towerhall.jp/tower/wp-content/uploads/2026/04/fee_01.png"
  },
  "catering": {
   "text": "2階の宴会場（イベントホール・蓬莱）は、船堀マツヤサロンの案内で、飲食物の持込みは食品衛生上の理由で原則お断り。大・小・展示ホールと会議室は、定められた場所以外での飲食・喫煙はご遠慮、定められた場所以外での飲酒はできない。ホール客席内での飲食はご遠慮。",
   "source": "https://funabori-matsuya.com/faq/"
  },
  "restaurants": {
   "text": "7階にレストラン「サロン・ド・サロン」（11:00〜21:00、食事のオーダーストップ20:00、ドリンクは20:30、年中無休）。1階にキャラバンコーヒー（9:00〜19:00）、キリンシティ（月〜土 11:30〜23:00、日・祝 11:30〜22:00）、つきじ植むら 旬泉坊（11:00〜15:00、17:00〜22:00）。",
   "source": "https://www.towerhall.jp/facility/"
  }
 },
