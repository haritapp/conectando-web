 "ops": {
  "prevDaySetup": {
   "text": "展示会の搬入は、前日の午前中から使う場合は展示会室料の全額、前日の正午から使う場合は展示会室料の半額がかかる。宴会・催事の使用時間は設営から撤去までを含み、契約時間を超えると追加室料がかかる（超過に応じられない場合もある）。（料金表 2025年8月現在、ご宴会・催事規約 2025年版）",
   "source": "https://www.hotel-mariners.co.jp/wp/wp-content/themes/mariners_child/lib/images/price_jpn_20250904.pdf"
  },
  "vehicleRules": {
   "text": "宴会・会議の利用者は、駐車場の利用は6時間まで無料。ご宴会の出席者が駐車場を使う場合は、ホテルの担当係員に確認する。飲酒運転根絶のため、酒気を帯びて運転するお客様には駐車場の無料券を出さない。",
   "source": "https://www.hotel-mariners.co.jp/wp/wp-content/uploads/2025/02/Banquet-Event-Agreement.pdf"
  },
  "parking": {
   "text": "56台（有料）。高さ制限2.1m。一般は30分500円、宴会・会議の利用は6時間まで無料、レストラン・カフェは2,000円以上の利用で1時間まで無料、宿泊者は1泊2,000円。",
   "source": "https://www.hotel-mariners.co.jp/"
  },
  "catering": {
   "text": "装飾・音響・照明・余興・コンパニオンはホテルの契約業者が手配する。ホテル以外の業者に直接頼む場合は、事前にホテルの担当係員へ連絡して了承を得る。立会いが必要なときは立会い人件費がかかる。ホテルの宴会プランは、会場費・料理・フリードリンク2時間・税・サービス料込みで1人8,500円〜12,000円（15名から。秋のパーティプラン 2026年9月1日〜11月15日、忘年会・新年会プラン 2026年11月16日〜2027年2月14日）。",
   "source": "https://www.hotel-mariners.co.jp/meeting-banquet-packages/"
  },
  "restaurants": {
   "text": "同じ建物に、レストラン（60席。ランチ11:30〜14:00、土日祝休み。朝食7:00〜9:30は宿泊しない人も利用可）とカフェ Roppongi Coffee（店内55席・テラス6席、8:00〜18:30）がある。最上階12階のレストラン「ル・アーブル」は宴会場としても貸し出していて、立食80名・着席60名。",
   "source": "https://www.hotel-mariners.co.jp/restaurant/"
  }
 },
