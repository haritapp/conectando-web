 "ops": {
  "loadingHours": {
   "text": "THE CLUB Fuji には直結した搬入口があり、車両搬入・展示が可能で、大規模な展示会にも対応する（宴会場パンフレット、会場詳細ページ）。",
   "source": "https://page.talkappi.com/?f=sheratontokyobay-qr&id=350009"
  },
  "parking": {
   "text": "敷地内にセルフパーキングがある。料金は1時間520円、1日3,100円。宿泊客は1台1泊3,100円、2泊目以降は1泊1,600円。",
   "source": "https://www.marriott.com/ja/hotels/tyosi-sheraton-grande-tokyo-bay-hotel/overview/"
  },
  "waitingRooms": {
   "text": "本館2Fの小宴会場「明海」「入船」（各約116〜119㎡）は、少人数の宴会や会議のほか、コンベンション事務局や控室にも使える。",
   "source": "https://my.ebook5.net/sheratontokyobay/sgtbmice/"
  },
  "catering": {
   "text": "ホテルのシェフによる料理と飲物（コース、ブッフェ、立食、ランチ、コーヒーブレイク、飲み放題プラン）を宴会場に用意する。会議・イベントページのケータリングサービス欄は、1人あたりコーヒーブレイク1,000円、アフタヌーンブレイク1,000円、ランチ4,000円、ディナー8,000円、レセプション5,500円、コンチネンタル朝食1,800円、本格的な朝食3,300円と表示している。",
   "source": "https://www.marriott.com/ja/hotels/tyosi-sheraton-grande-tokyo-bay-hotel/events/"
  },
  "restaurants": {
   "text": "館内に、グランカフェ（ブッフェ・ダイニング）・グランカフェ バー・ガレリアカフェ（カジュアル・ダイニング）が1階、舞浜Teppanyaki+（鉄板焼）・飛鳥（日本料理）・カフェ トスティーナが2階にある。",
   "source": "https://my.ebook5.net/sheratontokyobay/sgtbmice/"
  }
 },
