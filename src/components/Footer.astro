---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const base  = isEn ? '/en' : '';

const cols = isEn
  ? [
      {
        heading: 'ABOUT',
        href: `${base}/about`,
        links: [
          { label: 'About Us',        href: `${base}/about` },
          { label: 'News & Updates',  href: `${base}/news` },
        ],
      },
      { heading: 'BLOG', href: `${base}/blog`, links: [] },
      {
        heading: 'SERVICE',
        href: `${base}/service`,
        links: [
          { label: 'Event Management Support', href: `${base}/service#service-1` },
          { label: 'Japan Tours',              href: `${base}/service#service-2` },
          { label: 'Japan Entry Support',      href: `${base}/service#service-3` },
          { label: 'Media Operations',         href: `${base}/service#service-4` },
        ],
      },
    ]
  : [
      {
        heading: 'ABOUT',
        href: `${base}/about`,
        links: [
          { label: '会社概要',  href: `${base}/about` },
          { label: 'お知らせ', href: `${base}/news` },
        ],
      },
      { heading: 'BLOG', href: `${base}/blog`, links: [] },
      {
        heading: 'SERVICE',
        href: `${base}/service`,
        links: [
          { label: 'イベント運営支援', href: `${base}/service#service-1` },
          { label: '日本ツアー',       href: `${base}/service#service-2` },
          { label: '日本進出支援',     href: `${base}/service#service-3` },
          { label: 'メディア運用',     href: `${base}/service#service-4` },
        ],
      },
    ];

const stackLinks = [
  { label: 'CONTACT',  href: `${base}/contact` },
  { label: 'POLICY',   href: `${base}/policy` },
  { label: isEn ? 'CASE STUDIES' : '導入事例', href: `${base}/case` },
  { label: 'MEDIA',    href: 'https://bizintokyo.com', external: true },
];
---

<footer class="site-footer">
  <!-- 4カラム -->
  <div class="footer-grid">
    {cols.map(col => (
      <div class="footer-col">
        <a href={col.href} class="col-heading">{col.heading}</a>
        {col.links.length > 0 && (
          <ul class="col-links">
            {col.links.map(l => (
              <li>
                <a href={l.href} class="col-link">{l.label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
    <div class="footer-col footer-col-stack">
      {stackLinks.map(l => (
        <a
          href={l.href}
          class="col-heading"
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
        >
          {l.label}{l.external && <span class="ext-icon" aria-hidden="true"> ↗</span>}
        </a>
      ))}
    </div>
  </div>

  <!-- ボトムバー -->
  <div class="footer-bottom">
    <a href={isEn ? '/en/' : '/'} class="footer-logo">Conectando</a>
    <p class="footer-copy">© {new Date().getFullYear()} Conectando Inc. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  background: #1515b3;
  color: #ffffff;
  padding: 4rem 2rem 2rem;
}

/* ── 4カラムグリッド ── */
.footer-grid {
  max-width: 72rem;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.5rem;
  padding-bottom: 3rem;
}

@media (max-width: 768px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}

@media (max-width: 480px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
}

/* ── 各カラム ── */
.footer-col {
  display: flex;
  flex-direction: column;
}

.footer-col-stack {
  gap: 1.25rem;
}

.col-heading {
  display: block;
  font-size: .9375rem;
  font-weight: 700;
  color: #ffffff;
  text-decoration: none;
  margin-bottom: 1rem;
  transition: opacity .15s;
}
.col-heading:hover { opacity: .8; }
.footer-col-stack .col-heading { margin-bottom: 0; }

.col-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: .625rem;
}

.col-link {
  font-size: .875rem;
  color: #ffffff;
  opacity: .85;
  text-decoration: none;
  transition: opacity .15s;
}
.col-link:hover { opacity: 1; }

.ext-icon {
  font-size: .75em;
  opacity: .7;
}

/* ── ボトムバー ── */
.footer-bottom {
  max-width: 72rem;
  margin: 0 auto;
  padding-top: 2rem;
  border-top: 1px solid rgba(255,255,255,.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-logo {
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
  text-decoration: none;
  letter-spacing: -.01em;
}
.footer-logo:hover { opacity: .8; }

.footer-copy {
  font-size: .8125rem;
  color: rgba(255,255,255,.65);
}
</style>
