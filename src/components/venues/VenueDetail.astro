---
// src/components/venues/VenueDetail.astro — 会場ごとの運営者向けページ（日本語・英語共通）
// 数字・URLは日本語データが正本。英語は src/lib/venues-i18n.ts で文字だけ重ねる。
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../ContactCTA.astro';
import { COMMON_I } from '../../data/venue-common';
import VENUE_HOTELS from '../../data/venue-hotels.json';
import { getVenue, maxCapacity, maxArea, verifiedShops, OPS_ORDER, type Shop } from '../../lib/venues';
import {
  localizeVenue, UI, TYPE_LABEL_I, LAYOUT_LABEL_I, AREA_LABEL_I, OPS_LABEL_I,
  areaColumnPathI, formatNumberI, formatDateI, firstSentence, venuesRoot, type Lang,
} from '../../lib/venues-i18n';

interface Props { slug: string; lang: Lang }
const { slug, lang } = Astro.props;

const t = UI[lang];
const common = COMMON_I[lang];
const TYPE_LABEL = TYPE_LABEL_I[lang];
const LAYOUT_LABEL = LAYOUT_LABEL_I[lang];
const AREA_LABEL = AREA_LABEL_I[lang];
const OPS_LABEL = OPS_LABEL_I[lang];
const fmt = (n: number | string | null | undefined) => formatNumberI(n, lang);

const v = localizeVenue(getVenue(slug)!, lang);
const name = lang === 'en' ? v.nameEn! : v.nameJa;
const subName = lang === 'en' ? v.nameJa : v.nameEn;
const cap = maxCapacity(v);
const area = maxArea(v);
const notice = typeof v.notice === 'string' ? { text: v.notice } : v.notice ?? null;
const opsItems = OPS_ORDER.filter((k) => v.ops?.[k]).map((k) => ({ key: k, label: OPS_LABEL[k], ...v.ops[k]! }));

const shopGroups: { title: string; hint: string; list: Shop[] }[] = [
  { ...t.shopGroups.copyshop, list: verifiedShops(v.nearby?.copyshop) },
  { ...t.shopGroups.convenience, list: verifiedShops(v.nearby?.convenience) },
  { ...t.shopGroups.hundredYen, list: verifiedShops(v.nearby?.hundredYen) },
  { ...t.shopGroups.donki, list: verifiedShops(v.nearby?.donki) },
];
const hasShops = shopGroups.some((g) => g.list.length);

const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const isPdf = (u: string) => /\.pdf($|\?)/i.test(u);
const showCol = (k: 'areaM2' | 'ceilingM' | 'theater' | 'school' | 'ushape' | 'standing' | 'banquet') =>
  v.rooms.some((r) => typeof r[k] === 'number' || (typeof r[k] === 'string' && r[k] !== ''));
const cols = (['areaM2', 'ceilingM', 'theater', 'school', 'ushape', 'standing', 'banquet'] as const).filter(showCol);
const colLabel: Record<(typeof cols)[number], string> = {
  areaM2: t.areaCol, ceilingM: t.ceilingCol, ...LAYOUT_LABEL,
};
const checked = formatDateI(v.checkedAt, lang);
const hotelData = (VENUE_HOTELS as Record<string, { pageJa: string | null; pageEn: string | null; hotels: { nameJa: string; nameEn: string; accessJa: string; accessEn: string; urlJa: string; urlEn: string }[] }>)[slug];
const hotels = (hotelData?.hotels ?? []).map((h) => ({
  name: lang === 'en' ? h.nameEn : h.nameJa,
  access: lang === 'en' ? h.accessEn : h.accessJa,
  url: lang === 'en' ? h.urlEn : h.urlJa,
}));
const hotelsPage = lang === 'en' ? hotelData?.pageEn : hotelData?.pageJa;
const title = t.detailTitle(name);
const description = t.detailDesc(name);
const areaPath = AREA_LABEL[v.area] ? areaColumnPathI(v.area, lang) : null;
---

<BaseLayout title={`${title} | Conectando`} rawTitle description={description}>
  <div class="vd-wrap">
    <nav class="vd-crumb" aria-label={t.crumbAria}><a href={t.homeHref}>{t.home}</a> <span>›</span> <a href={t.listHref}>{t.listName}</a> <span>›</span> {name}</nav>

    <header class="vd-head">
      <div class="vd-badges">
        <span class="vd-badge">{TYPE_LABEL[v.type]}</span>
        {areaPath && <a class="vd-area" href={areaPath}>{AREA_LABEL[v.area]}</a>}
      </div>
      <h1 class="vd-h1">{name}</h1>
      {subName && <p class="vd-en" lang={lang === 'en' ? 'ja' : undefined}>{subName}</p>}
    </header>

    {v.photo && (
      <figure class="vd-photo">
        <img src={v.photo.src} alt={t.photoAlt(name)} width="1200" loading="eager" />
        <figcaption>{v.photo.sourceUrl ? <a href={v.photo.sourceUrl} target="_blank" rel="noopener">{v.photo.credit}</a> : v.photo.credit}</figcaption>
      </figure>
    )}

    {notice && (
      <div class="vd-notice">
        <strong>{t.notice}</strong>
        <p>{notice.text}{notice.source && <>{t.noticeOpen}<a href={notice.source} target="_blank" rel="noopener">{t.noticeSource}</a>{t.noticeClose}</>}</p>
      </div>
    )}

    <section class="vd-summary">
      <dl>
        <div><dt>{t.maxCap}</dt><dd>{cap ? <>{t.people(fmt(cap.people))}<small>{t.capSmall(cap.room, LAYOUT_LABEL[cap.layout])}</small></> : '—'}</dd></div>
        <div><dt>{t.largestRoom}</dt><dd>{area ? `${fmt(area)}㎡` : '—'}</dd></div>
        <div><dt>{t.address}</dt><dd>{v.address}</dd></div>
        {v.accessSummary && <div><dt>{t.station}</dt><dd>{v.accessSummary}</dd></div>}
        {v.hours && <div><dt>{t.openHours}</dt><dd>{v.hours}</dd></div>}
        <div><dt>{t.official}</dt><dd><a href={v.officialUrl} target="_blank" rel="noopener">{hostOf(v.officialUrl)}</a>{v.organizerUrl && <>　<a href={v.organizerUrl} target="_blank" rel="noopener">{t.organizerGuide}</a></>}</dd></div>
      </dl>
    </section>

    <nav class="vd-toc" aria-label={t.tocAria}>
      {v.rooms.length > 0 && <a href="#rooms">{t.tocRooms}</a>}
      {(v.documents?.length ?? 0) > 0 && <a href="#docs">{t.tocDocs}</a>}
      {opsItems.length > 0 && <a href="#ops">{t.tocOps}</a>}
      <a href="#shops">{t.tocShops}</a>
      {hotels.length > 0 && <a href="#hotels">{t.tocHotels}</a>}
    </nav>

    {v.rooms.length > 0 && (
      <section id="rooms" class="vd-sec">
        <h2>{t.tocRooms}</h2>
        <div class="vd-tablewrap">
          <table class="vd-table">
            <thead><tr><th>{t.roomCol}</th>{cols.map((c) => <th>{colLabel[c]}</th>)}</tr></thead>
            <tbody>
              {v.rooms.map((r) => (
                <tr>
                  <th scope="row">{r.name}{r.note && <small>{r.note}</small>}</th>
                  {cols.map((c) => <td>{fmt(r[c])}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {v.roomsSource && /^https?:/.test(v.roomsSource) && (
          <p class="vd-small">{t.roomsSource}<a href={v.roomsSource} target="_blank" rel="noopener">{hostOf(v.roomsSource)}</a>{t.roomsSourceTail}</p>
        )}
      </section>
    )}

    {(v.documents?.length ?? 0) > 0 && (
      <section id="docs" class="vd-sec">
        <h2>{t.docsH2}</h2>
        <ul class="vd-docs">
          {v.documents!.map((d) => <li><a href={d.url} target="_blank" rel="noopener">{d.title}</a>{isPdf(d.url) && <span>{t.pdf}</span>}</li>)}
        </ul>
      </section>
    )}

    {opsItems.length > 0 && (
      <section id="ops" class="vd-sec">
        <h2>{t.opsH2}</h2>
        <div class="vd-ops">
          {opsItems.map((o) => (
            <div class="vd-op">
              <h3>{o.label}</h3>
              <p>{o.text}</p>
              <a class="vd-src" href={o.source} target="_blank" rel="noopener">{t.source}{hostOf(o.source)}{isPdf(o.source) ? t.pdfMark : ''}</a>
            </div>
          ))}
        </div>
        <p class="vd-small">{common.opsNote}{t.checked(checked)}</p>
      </section>
    )}

    <section id="shops" class="vd-sec">
      <h2>{t.shopsH2}</h2>
      {hasShops ? (
        <div class="vd-shops">
          {shopGroups.filter((g) => g.list.length).map((g) => (
            <div class="vd-shopgroup">
              <h3>{g.title}</h3>
              <p class="vd-hint">{g.hint}</p>
              <ul>
                {g.list.map((s) => (
                  <li>
                    <span class="vd-walk">{t.walk(s.walkMin)}</span>
                    <span class="vd-shopname">{s.source ? <a href={s.source} target="_blank" rel="noopener">{s.name}</a> : s.name}</span>
                    {s.hours && <span class="vd-hours">{s.hours}</span>}
                    {s.note && (s.showNote ?? /横断|遠い|会場内|敷地内|同じ住所/.test(s.note)) && <span class="vd-hours">{firstSentence(s.note, lang)}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        <p>{t.shopsPending}</p>
      )}
      {v.drinkDelivery?.available && (
        <div class="vd-delivery">
          <h3>{t.deliveryH3}</h3>
          <p>{t.deliveryIntro(common.drinkDelivery.provider, common.drinkDelivery.text)}</p>
          <p class="vd-small">{t.deliverySrc}{common.drinkDelivery.sources.map((s, i) => <>{i > 0 && (lang === 'ja' ? '・' : ' / ')}<a href={s.url} target="_blank" rel="noopener">{s.title}</a></>)}</p>
        </div>
      )}
      <p class="vd-small">{t.shopsFooter(common.walkNote, checked)}</p>
    </section>

    <section class="vd-sec vd-related">
      <h2>{t.relatedH2}</h2>
      <ul>
        {areaPath && <li><a href={areaPath}>{t.relatedArea(AREA_LABEL[v.area])}</a></li>}
        <li><a href={t.mitsumoriHref}>{t.mitsumoriTitle}</a></li>
        {v.bizintokyoSlug && <li><a href={`${t.bizintokyoBase}${v.bizintokyoSlug}/`} target="_blank" rel="noopener">{t.bizintokyo(name)}</a></li>}
      </ul>
    </section>

    {hotels.length > 0 && (
      <section id="hotels" class="vd-sec vd-hotels">
        <h2>{t.hotelsH2}</h2>
        <p>{t.hotelsLead(name)}</p>
        <ul>
          {hotels.map((h) => (
            <li>
              <a href={h.url} target="_blank" rel="sponsored noopener">{h.name}</a>
              <span>{h.access}</span>
            </li>
          ))}
        </ul>
        <p class="vd-small">{t.hotelsAd}</p>
        {hotelsPage && <p><a href={hotelsPage} target="_blank" rel="noopener">{t.hotelsMore(name)}</a></p>}
      </section>
    )}

    <div class="vd-back"><a href={t.listHref}>{t.back}</a></div>
  </div>

  <ContactCTA trackSource="venue_detail" />
</BaseLayout>

<style>
.vd-wrap { max-width: 52rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
.vd-crumb { font-size: .8125rem; color: var(--color-text-muted); margin-bottom: 1.25rem; }
.vd-crumb span { margin: 0 .25rem; }
.vd-badges { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
.vd-badge { font-size: .75rem; font-weight: 700; color: #fff; background: var(--color-brand); padding: .125rem .625rem; border-radius: 999px; }
.vd-area { font-size: .8125rem; }
.vd-h1 { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: var(--color-heading); margin: .5rem 0 .25rem; line-height: 1.35; }
.vd-en { color: var(--color-text-muted); margin: 0; font-size: .9375rem; }
.vd-photo { margin: 1.25rem 0 0; }
.vd-photo img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-md); display: block; background: var(--color-accent); }
.vd-photo figcaption { font-size: .6875rem; color: var(--color-text-muted); margin-top: .25rem; text-align: right; }
.vd-photo figcaption a { color: inherit; }
.vd-notice { margin: 1.25rem 0; padding: .875rem 1rem; border-left: 4px solid #d97706; background: #fffbeb; border-radius: var(--radius-sm); }
.vd-notice strong { color: #92400e; font-size: .875rem; }
.vd-notice p { margin: .25rem 0 0; font-size: .9375rem; line-height: 1.7; }
.vd-summary { margin: 1.5rem 0; background: var(--color-accent); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1rem 1.25rem; }
.vd-summary dl { margin: 0; display: grid; gap: .625rem; }
.vd-summary div { display: grid; grid-template-columns: 7.5rem 1fr; gap: .75rem; }
.vd-summary dt { font-size: .8125rem; color: var(--color-text-muted); font-weight: 700; }
.vd-summary dd { margin: 0; font-size: .9375rem; overflow-wrap: anywhere; }
.vd-summary small { color: var(--color-text-muted); margin-left: .25rem; }
.vd-toc { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
.vd-toc a { font-size: .8125rem; padding: .25rem .75rem; border: 1px solid var(--color-border); border-radius: 999px; }
.vd-sec { margin-top: 2.5rem; }
.vd-sec h2 { font-size: 1.25rem; font-weight: 700; color: var(--color-heading); border-bottom: 2px solid var(--color-brand); padding-bottom: .375rem; margin: 0 0 1rem; }
.vd-sec h3 { font-size: 1rem; font-weight: 700; color: var(--color-heading); margin: 0 0 .375rem; }
.vd-ops { display: grid; gap: 1rem; }
.vd-op { padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.vd-op p { margin: 0 0 .5rem; line-height: 1.8; font-size: .9375rem; }
.vd-src { font-size: .75rem; }
.vd-small { font-size: .75rem; color: var(--color-text-muted); line-height: 1.7; margin-top: .75rem; }
.vd-shops { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
.vd-shopgroup { padding: 1rem; border: 1px solid #f3dcae; background: #fffcf5; border-radius: var(--radius-md); }
.vd-hint { font-size: .8125rem; color: var(--color-text-muted); margin: 0 0 .625rem; }
.vd-shopgroup ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
.vd-shopgroup li { display: grid; grid-template-columns: auto 1fr; gap: .125rem .625rem; font-size: .875rem; }
.vd-walk { font-weight: 700; color: #8a5a00; white-space: nowrap; }
.vd-shopname { min-width: 0; overflow-wrap: anywhere; }
.vd-hours { grid-column: 2; font-size: .75rem; color: var(--color-text-muted); }
.vd-delivery { margin-top: 1rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.vd-delivery p { margin: 0; font-size: .9375rem; line-height: 1.8; }
.vd-tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.vd-table { width: 100%; border-collapse: collapse; font-size: .875rem; min-width: 32rem; }
.vd-table th, .vd-table td { padding: .5rem .625rem; border-bottom: 1px solid var(--color-border); text-align: right; white-space: nowrap; }
.vd-table thead th { background: var(--color-accent); font-size: .75rem; color: var(--color-heading); }
.vd-table th[scope='row'], .vd-table thead th:first-child { text-align: left; white-space: normal; min-width: 9rem; }
.vd-table th[scope='row'] small { display: block; font-weight: 400; font-size: .6875rem; color: var(--color-text-muted); line-height: 1.5; margin-top: .125rem; }
.vd-docs { padding-left: 1.25rem; line-height: 2; }
.vd-docs span { font-size: .6875rem; margin-left: .375rem; padding: 0 .375rem; border: 1px solid var(--color-border); border-radius: 3px; color: var(--color-text-muted); }
.vd-related ul { padding-left: 1.25rem; line-height: 2; }
.vd-hotels p { font-size: .9375rem; line-height: 1.8; margin: 0 0 .75rem; }
.vd-hotels ul { list-style: none; padding: 0; margin: 0 0 .5rem; display: grid; gap: .5rem; }
.vd-hotels li { display: grid; gap: .125rem; padding: .625rem .875rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: .9375rem; }
.vd-hotels li span { font-size: .75rem; color: var(--color-text-muted); }
.vd-hotels p.vd-small { font-size: .75rem; margin: 0 0 .75rem; }
.vd-back { margin-top: 2.5rem; }
@media (max-width: 480px) {
  .vd-summary div { grid-template-columns: 1fr; gap: .125rem; }
}
</style>
